# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Contact form (optional) — your Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# YouTube Data API v3 (optional) — for video solution recommendations
YOUTUBE_API_KEY=

